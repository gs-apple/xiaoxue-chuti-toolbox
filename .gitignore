# 忽略 Claude 配置文件
.claude/

# WorkBuddy 项目数据目录（参考素材/工作日志，不入库）
.workbuddy/

# 忽略打包产物
build/
dist/

# 运行时数据文件
.question_cache.json
.zhenti_favorites.json
.zhenti_favorites.json.corrupt

# 真题下载的文件（落盘在主程序根目录，只忽略白名单里的卷子类型）
/*.rar
/*.zip
/*.7z
/*.pdf
/*.doc
/*.docx
/*.xls
/*.xlsx

# 其他常见的 Python 项目忽略项
*.log
*.spec
__pycache__/
*.pyc
venv/
.venv/

# 一次性脚本与中间产物（教材提取 / 爬虫 dump / 数据备份）
tmp_*.py
tmp_slb_extract/
sl_extract/
suyang_dump/
*.bak
*.bak[0-9]*
*.bak*_clean
compare_report.txt

# 清理备份包
清理备份_*.zip
_清理备份_*/
